// Shared workbook; serializedData is generated by tools/build_workbook.py (workbook/workbook.template.json).
param location string
param workbookId string
param displayName string = 'Azure Maintenance Ledger'
param workspaceId string
param serializedTemplate string
param tags object = {}

resource wb 'Microsoft.Insights/workbooks@2023-06-01' = {
  name: workbookId
  location: location
  kind: 'shared'
  tags: tags
  properties: {
    category: 'workbook'
    displayName: displayName
    sourceId: workspaceId
    serializedData: replace(serializedTemplate, '__WORKSPACE_ID__', workspaceId)
  }
}

output id string = wb.id
