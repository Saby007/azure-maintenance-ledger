// purpose: KPI tiles for the Planned maintenance page. Planned windows are scheduled windows, NOT downtime.
// outputs: order, metric, value, subtitle, status
let p = AzOutage_Planned({IncludeSynthetic})
    | where '*' in ({Subscriptions}) or subscription_id in ({Subscriptions})
    | summarize arg_min(window_start_utc, *) by tracking_id;
let in_range = p | where not(upcoming) and window_start_utc between ({TimeRange:start} .. {TimeRange:end});
let soon = toscalar(p | where upcoming and window_start_utc < now() + 30d | summarize dcount(tracking_id));
let notices = toscalar(in_range | summarize dcount(tracking_id));
let lead = toscalar(in_range | where lead_time_days >= 0 | summarize round(avg(lead_time_days), 1));
let sched = toscalar(in_range | summarize round(sum(scheduled_h), 1));
let realised = toscalar(in_range | summarize round(sum(realised_downtime_min), 1));
let measured = toscalar(in_range | summarize countif(isnotnull(realised_downtime_min)));
datatable(order: int)[1, 2, 3, 4, 5]
| extend metric = case(order == 1, "Starting in the next 30 days", order == 2, "Maintenance notices in range", order == 3, "Typical notice (days)",
                       order == 4, "Scheduled windows (hours)", "Realised downtime (minutes)"),
         value = case(order == 1, todouble(soon), order == 2, todouble(notices), order == 3, todouble(lead), order == 4, todouble(sched), todouble(realised)),
         subtitle = case(order == 1, "Upcoming planned maintenance",
                         order == 2, "Announced maintenance in the selected range",
                         order == 3, "How far ahead the ledger saw the notice",
                         order == 4, "Planned windows, not downtime",
                         iff(measured == 0, "Not measured: no overlapping Resource Health data", "Unavailable time during maintenance, your resources")),
         status = case(order == 1, iff(soon > 0, "info", "good"), order == 5, iff(measured == 0, "info", iff(coalesce(realised, 0.0) == 0, "good", "warn")), "info")
| project order, metric, value, subtitle, status
| order by order asc
