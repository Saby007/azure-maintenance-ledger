// purpose: parameter source - categories from the service catalog; shows "(no data yet)" until the catalog is loaded. outputs: value, label
let rows = AzMaintenance_Catalog({IncludeSynthetic})
    | summarize by category
    | project value = category, label = category;
let n = toscalar(rows | count);
rows
| union (print value = "(no data yet)", label = "(no data yet)" | where n == 0)
