// purpose: KPI tiles for the chosen service/region from the preferred planning range. Evidence, not a forecast or guarantee.
// outputs: order, metric, value, subtitle, status
//#include _planner_base
rows
| where basis == "Your estate" and picked == true
| take 1
| mv-expand order = dynamic([1, 2, 3, 4]) to typeof(int)
| extend metric = case(order == 1, "Typical year (P50, hours)", order == 2, "Bad year (P90, hours)", order == 3, "Expected events per year", "Based on (past events)"),
         value = case(order == 1, p50_annual_h, order == 2, p90_annual_h, order == 3, events_per_year, todouble(n_events)),
         subtitle = case(order == 1, "Half of years should be at or below this",
                         order == 2, "9 in 10 years should be at or below this",
                         order == 3, strcat("Scope: ", scope_key, "; window ", window_days, " days"),
                         strcat("Confidence: ", confidence, "; durations from ", replace_string(duration_basis, "_", " "))),
         status = case(confidence == "high", "good", confidence == "medium", "info", "warn")
| project order, metric, value, subtitle, status
| order by order asc
