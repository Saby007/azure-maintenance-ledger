# Settings for scripts and the CLI tools (copy to .env, which is git-ignored). No secrets here.
# Sandbox/dev deployment target used by scripts\deploy.ps1 (not needed for the one-click button).
AOL_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AOL_RESOURCE_GROUP=rg-aol-sandbox
AOL_LOCATION=centralindia
AOL_PREFIX=aol

# Subscriptions the CLI collectors read (comma separated). Overrides config/subscriptions.json.
AOL_SUBSCRIPTIONS=00000000-0000-0000-0000-000000000000

# Filled in from deployment outputs.
AOL_WORKSPACE_ID=
AOL_DCR_ENDPOINT=
AOL_DCR_IMMUTABLE_ID=
AOL_STATE_ACCOUNT_URL=
